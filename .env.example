# Copy this file to .env.local and fill in at least ONE LLM API key.
# .env.local is gitignored; .env.example is safe to commit.
#
# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── LLM PROVIDERS (add one or more — system auto-routes & falls back) ───────
#
# Option 1 — Anthropic Claude (paid, best quality)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: override default model (claude-3-5-sonnet-latest)
# ANTHROPIC_MODEL=claude-opus-4-7

# Option 2 — Google Gemini (free tier available)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: override default model (gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-pro

# Option 3 — OpenRouter (access 50+ models, many free)
# Get key at: https://openrouter.ai/keys
# Free models auto-tried in order: gemini-2.5-flash, deepseek-chat, llama-3-8b, qwen-2.5-72b
OPENROUTER_API_KEY=
